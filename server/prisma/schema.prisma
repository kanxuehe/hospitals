// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Temporary placeholder model.
// Why: NestJS eagerly instantiates PrismaService (it implements OnModuleInit)
// during bootstrap, which constructs PrismaClient. With an empty schema
// `prisma generate` emits nothing and `new PrismaClient()` throws
// "@prisma/client did not initialize yet", so the app cannot boot.
// This model lets the client be generated so the scaffold starts cleanly.
// Task 2 will replace this entire schema with the full data model
// (Province, City, Hospital, ClinicService, ...).
model ScaffoldPlaceholder {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}
